{
  "animeSite": {
    "enabled": true,
    "name": "French-Manga",
    "baseUrl": "https://w16.french-manga.net",
    "ajaxSearch": "/engine/ajax/search.php",
    "episodesApi": "/engine/ajax/manga_episodes_api.php?id="
  },
  "movieSeriesSite": {
    "enabled": true,
    "name": "French-Stream",
    "baseUrl": "",
    "discoveryUrl": "https://fstream.net/",
    "ajaxSearch": "/engine/ajax/search.php",
    "serieStatic": "/static/series/{id}.js",
    "serieFallbacks": ["/data/eps_{id}.txt", "/ep-data.php?id={id}"],
    "filmMenu": "/engine/ajax/film-menu.php?news_id={id}"
  },
  "redirectService": {
    "enabled": true,
    "name": "FStream-Hub",
    "baseUrl": "https://fstream.net",
    "mode": "hub",
    "target": "",
    "note": "Cible découverte depuis le lien 'Regarder en streaming' de la page relais, puis conservée comme dernière adresse vérifiée."
  },
  "settings": {
    "lang": "fr",
    "defaultQuality": "HD",
    "cacheSearchMinutes": 60,
    "cacheStreamMinutes": 10,
    "cacheMetaDays": 30,
    "requestTimeoutMs": 20000,
    "maxConcurrency": 3
  }
}
